# Point the UI at a Priompt server. With none of these set the UI runs on
# sample data and says so in a banner.
#
# One variable carries both the address and the credential, the same way the Go
# CLI and both SDKs read it:
PRIOMPT_URL=priompt://your-token@localhost:8443

# Or set them separately (these win over PRIOMPT_URL):
# PRIOMPT_HOST=localhost:8443
# PRIOMPT_TOKEN=your-token
# PRIOMPT_TLS=true

# The token is read server-side only and is never sent to the browser. It is an
# org-scoped credential with no per-user authorization beneath it, so treat it
# as the whole org: use a read-only token unless the UI needs to publish.

# When the token is org-scoped, name the org. A scoped token may not list with an
# empty prefix — that would mean "everything" — so the dashboard cannot discover
# which org it is scoped to on its own.
# PRIOMPT_ORG=acme
